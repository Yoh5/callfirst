# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALLFIRST_KEY=
# The signing key registered with Ring (or with the emulator) for webhooks.
RING_WEBHOOK_KEY=
# Guards the household API until the pages have real sign-in.
CALLFIRST_ADMIN_TOKEN=
RING_API_BASE=http://127.0.0.1:8787
RING_TOKEN=sandbox
CALLFIRST_DATA=data
CALLFIRST_BASE_URL=http://127.0.0.1:8100
CALLFIRST_SENDER=Call First <alerts@callfirst.invalid>
# Optional: real email. Without SMTP_HOST, emails are written to $CALLFIRST_DATA/mail/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: read pasted delivery messages with a model. Without it, rules read them.
ANTHROPIC_API_KEY=
